---
layout: default
---
<%# The full-viewport treatment: the name sits just above the midline, the
    links just below it. The title block is the whole content of such a page,
    so it *is* the <main> — there is no separate header to put it in. %>
<main>
  <div class="title">
    <h1><%= resource.data.title.to_s.empty? ? site.metadata.title : resource.data.title %></h1>

    <p class="tagline">
      <span class="no-break"><%= resource.data.subtitle || site.metadata.tagline %></span>
    </p>
  </div>

  <%# A splash page is usually just the title block, so the wrapper is only
      emitted when the page actually supplied a body — otherwise its margin
      would push the title block off the midline on the home page, which
      supplies none. %>
  <% body = yield %>
  <% unless body.to_s.strip.empty? %>
    <div class="splash-body"><%= body %></div>
  <% end %>
</main>
