<%# The shell, and nothing else: everything here is true of every page.
    The footer stays because it never varies; the header does not, because a
    splash page and a prose page need different ones. Child layouts supply it. %>
<!doctype html>
<html lang="<%= site.locale %>">
  <head>
    <%= render "head", metadata: site.metadata, title: resource.data.title, resource: resource %>
  </head>

  <%# Both classes, not one or the other: the layout name carries the geometry
      and `page_class` is a per-page modifier on top of it, so `404.html` is
      `splash not-found` rather than losing the splash treatment entirely.
      `resource.data` rather than a bare `data` — once layouts chain, `data`
      alone no longer says whose front matter you mean. %>
  <body class="<%= [resource.data.layout, resource.data.page_class].compact.join(" ") %>">
    <%= yield %>

    <%= render "site_footer", metadata: site.metadata %>
  </body>
</html>
