<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<% resource_title = strip_html(strip_newlines(title.to_s)) %>
<% full_title = resource_title.empty? ? metadata.title : "#{resource_title} | #{metadata.title}" %>
<title><%= full_title %></title>

<meta name="description" content="<%= metadata.description %>" />
<meta name="author" content="<%= metadata.title %>" />
<% if resource.data.noindex %>
<meta name="robots" content="noindex" />
<% else %>
<link rel="canonical" href="<%= resource.absolute_url %>" />
<% end %>

<%# `favicon.ico` is at the site root because that is where a browser looks
    for it unprompted; the link tag only saves it the guess. Both are raster
    renders of `design/favicon.svg` — see that file for why it is not linked
    as an SVG icon directly. %>
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="<%= metadata.title %>" />
<meta property="og:title" content="<%= full_title %>" />
<meta property="og:description" content="<%= metadata.description %>" />
<meta property="og:url" content="<%= resource.absolute_url %>" />
<meta property="og:image" content="<%= absolute_url(metadata.image) %>" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="<%= metadata.title %> — <%= metadata.tagline %>" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
