<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<% resource_title = strip_html(strip_newlines(title.to_s)) %>
<title><% if resource_title.empty? %><%= metadata.title %><% else %><%= resource_title %> | <%= metadata.title %><% end %></title>

<meta name="description" content="<%= metadata.description %>" />
<meta name="author" content="<%= metadata.title %>" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400&display=swap" />

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
